{
  "name": "onlinefood",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate && next dev",
    "dev:prepare": "prisma migrate dev && prisma generate",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:check": "npx tsx scripts/check-db.ts",
    "db:stabilize": "npx tsx scripts/stabilize-db.ts",
    "pwa:assets": "npx tsx scripts/generate-pwa-assets.ts",
    "pwa:bootstrap": "npx tsx scripts/bootstrap-pwa-icons.ts",
    "brand:images": "npx tsx scripts/generate-brand-images.ts",
    "check:env": "npx tsx scripts/check-env.ts",
    "billing:monthly": "npx tsx scripts/run-monthly-billing.ts",
    "billing:example": "npx tsx scripts/generate-example-invoice.ts",
    "billing:test-email": "npx tsx scripts/test-billing-email.ts",
    "test": "tsx --test tests/billing/**/*.test.ts tests/security/**/*.test.ts tests/rms/**/*.test.ts tests/payment/**/*.test.ts tests/integration/**/*.test.ts tests/e2e/**/*.test.ts",
    "test:billing": "tsx --test tests/billing/**/*.test.ts",
    "test:security": "tsx --test tests/security/**/*.test.ts",
    "test:payment": "tsx --test tests/payment/**/*.test.ts",
    "launch:env": "npx tsx scripts/launch/env-checklist.ts",
    "launch:e2e": "npx tsx scripts/launch/e2e-verify.ts",
    "launch:isolation": "npx tsx scripts/launch/tenant-isolation-verify.ts",
    "launch:sprint": "npx tsx scripts/launch/run-sprint.ts",
    "launch:setup-local": "npx tsx scripts/launch/setup-local-env.ts",
    "ops:backup": "npx tsx scripts/ops/backup-database.ts",
    "ops:restore": "npx tsx scripts/ops/restore-database.ts",
    "menu:sync": "npx tsx scripts/sync-printed-menu.ts",
    "print-agent": "npx tsx tools/print-agent/run.ts",
    "print-agent:install": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/print-agent/install-service.ps1",
    "print-agent:build": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/print-agent/build-installer.ps1"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "@prisma/client": "^6.19.3",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.8",
    "@tanstack/react-virtual": "^3.14.3",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.3",
    "lucide-react": "^0.563.0",
    "next": "16.1.6",
    "next-auth": "^5.0.0-beta.31",
    "nodemailer": "^8.0.0",
    "pdf-lib": "^1.17.1",
    "prisma": "^6.19.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "^6.9.1",
    "stripe": "^22.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.9",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "playwright": "^1.52.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "5.9.3"
  }
}
