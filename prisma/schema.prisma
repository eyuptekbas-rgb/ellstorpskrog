generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  PLATFORM_ADMIN
  ADMIN
  STAFF
}

enum StaffJobRole {
  OWNER
  MANAGER
  KITCHEN
  CASHIER
  DELIVERY
  WAITER
  CUSTOM
}

enum StaffStatus {
  INVITED
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  NEW
  CONFIRMED
  PREPARING
  READY
  DELIVERING
  COMPLETED
  CANCELLED
}

enum OrderType {
  PICKUP
  DELIVERY
}

enum PaymentMethod {
  CARD
  ON_PICKUP
  ON_DELIVERY
  APPLE_PAY
  GOOGLE_PAY
  SWISH
  MOBILEPAY
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum NotificationType {
  CUSTOMER_ORDER_CONFIRMATION
  CUSTOMER_PAYMENT_CONFIRMATION
  CUSTOMER_ORDER_READY
  CUSTOMER_ORDER_DELIVERED
  CUSTOMER_ORDER_CANCELLED
  RESTAURANT_NEW_ORDER
  RESTAURANT_PAYMENT_RECEIVED
  RESTAURANT_ORDER_CANCELLED
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum ReservationStatus {
  NEW
  CONFIRMED
  SEATED
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum CustomerVipLevel {
  REGULAR
  SILVER
  GOLD
  VIP
}

enum PlatformInvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

model Tenant {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  templateId    String   @default("dark-copper-premium")
  primaryColor  String   @default("#b85c38")
  logo          String?
  active        Boolean  @default(true)
  /// Per-tenant admin panel module toggles (JSON object of featureId → boolean)
  adminFeatures Json?
  /// Platform billing (SEK, whole kronor)
  monthlySubscriptionFee Int     @default(0)
  orderFee             Int     @default(0)
  billingVatRate       Int?
  invoiceEmail         String?
  companyName          String?
  organizationNumber   String?
  billingAddress       String?
  /// Unique 8-digit platform customer number (e.g. 00000001)
  customerNumber       String? @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  settings      SiteSettings?
  users         User[]
  categories    Category[]
  extraOptions  ExtraOption[]
  orders        Order[]
  openingHours  OpeningHours[]
  deliveryZones DeliveryZone[]
  reservations  Reservation[]
  restaurantTables RestaurantTable[]
  customerProfiles CustomerCrmProfile[]
  platformInvoices PlatformInvoice[]
  payments      Payment[]
  paymentSettings BusinessPaymentSettings?
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  firstName     String?
  lastName      String?
  phone         String?  @unique
  address       String?
  postalCode    String?
  city          String?
  passwordHash  String?
  role          UserRole @default(CUSTOMER)
  tenantId      String?
  loyaltyPoints Int      @default(0)
  staffJobRole  StaffJobRole?
  staffStatus   StaffStatus?
  customRoleLabel String?
  permissions   Json     @default("[]")
  lastLoginAt   DateTime?
  forceLogoutBefore DateTime?
  twoFactorEnabled Boolean @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tenant        Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  orders        Order[]
  addresses     CustomerAddress[]
  favoriteOrders FavoriteOrder[]
  reservations  Reservation[]
  crmProfile    CustomerCrmProfile?
  staffNotes    StaffNote[]
  loginEvents   StaffLoginEvent[]
  auditLogsAsActor StaffAuditLog[] @relation("StaffAuditActor")
  auditLogsAsTarget StaffAuditLog[] @relation("StaffAuditTarget")

  @@index([tenantId])
  @@index([staffStatus])
  @@index([staffJobRole])
}

model CustomerAddress {
  id         String   @id @default(cuid())
  userId     String
  label      String?
  address    String
  postalCode String
  city       String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model FavoriteOrder {
  id        String   @id @default(cuid())
  userId    String
  label     String?
  itemsJson String
  orderId   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Category {
  id           String                @id @default(cuid())
  tenantId     String
  slug         String
  name         String
  image        String?
  icon         String?
  sortOrder    Int                   @default(0)
  active       Boolean               @default(true)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products     Product[]
  extraOptions CategoryExtraOption[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model Product {
  id            String               @id @default(cuid())
  categoryId    String
  name          String
  description   String
  ingredients   String               @default("")
  allergens     String               @default("")
  price         Int
  campaignPrice Int?
  campaignStart DateTime?
  campaignEnd   DateTime?
  image         String?
  active        Boolean              @default(true)
  hidden        Boolean              @default(false)
  soldOut       Boolean              @default(false)
  isPopular     Boolean              @default(false)
  isNew         Boolean              @default(false)
  isVegetarian  Boolean              @default(false)
  isGlutenFree  Boolean              @default(false)
  spicyLevel    Int                  @default(0)
  sortOrder     Int                  @default(0)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  category      Category             @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems    OrderItem[]
  optionGroups  ProductOptionGroup[]

  @@index([categoryId])
}

model ProductOptionGroup {
  id        String              @id @default(cuid())
  productId String
  name      String
  required  Boolean             @default(false)
  minSelect Int                 @default(0)
  maxSelect Int                 @default(1)
  sortOrder Int                 @default(0)
  product   Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  options   ProductOptionItem[]

  @@index([productId])
}

model ProductOptionItem {
  id            String             @id @default(cuid())
  groupId       String
  name          String
  priceModifier Int                @default(0)
  sortOrder     Int                @default(0)
  group         ProductOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
}

model ExtraOption {
  id            String                @id @default(cuid())
  tenantId      String
  name          String
  priceModifier Int                   @default(0)
  sortOrder     Int                   @default(0)
  active        Boolean               @default(true)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categories    CategoryExtraOption[]

  @@index([tenantId])
}

model CategoryExtraOption {
  id            String      @id @default(cuid())
  categoryId    String
  extraOptionId String
  sortOrder     Int         @default(0)
  category      Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  extraOption   ExtraOption @relation(fields: [extraOptionId], references: [id], onDelete: Cascade)

  @@unique([categoryId, extraOptionId])
  @@index([categoryId])
  @@index([extraOptionId])
}

model Order {
  id              String               @id @default(cuid())
  tenantId        String
  orderNumber     String
  userId          String?
  customerName    String
  customerPhone   String
  customerEmail   String
  customerAddress String?
  orderType       OrderType
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus        @default(PENDING)
  stripeSessionId String?              @unique
  paymentIntentId String?
  note            String?
  adminNote       String?
  total                 Int
  estimatedReadyMinutes Int?
  status                OrderStatus          @default(NEW)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  statusHistory   OrderStatusHistory[]
  notificationLogs NotificationLog[]
  payments        Payment[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  businessId        String
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("SEK")
  provider          String
  providerPaymentId String?
  providerReference String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  paidAt            DateTime?
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  business          Tenant        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  webhookEvents     PaymentWebhookEvent[]

  @@unique([provider, providerPaymentId])
  @@index([orderId])
  @@index([businessId])
  @@index([status])
  @@index([method])
  @@index([providerReference])
  @@index([createdAt])
  @@index([businessId, createdAt])
  @@index([businessId, status])
  @@index([businessId, orderId])
  @@index([businessId, providerReference])
}

model PaymentWebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  eventId     String
  paymentId   String?
  payloadHash String
  processedAt DateTime @default(now())
  payment     Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([provider, eventId])
  @@index([paymentId])
  @@index([processedAt])
}

model BusinessPaymentSettings {
  businessId            String   @id
  cardEnabled           Boolean  @default(false)
  applePayEnabled       Boolean  @default(false)
  googlePayEnabled      Boolean  @default(false)
  swishEnabled          Boolean  @default(false)
  mobilePayEnabled      Boolean  @default(false)
  stripePublishableKey  String?
  stripeSecretKey       String?
  swishMerchantNumber   String?
  mobilePayMerchantId   String?
  isLive                Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  business              Tenant   @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([isLive])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String?
  productName String
  quantity    Int
  unitPrice   Int
  totalPrice  Int
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

model SiteSettings {
  tenantId        String   @id
  restaurantName  String   @default("Restaurang")
  phone           String
  email           String
  address         String
  logo            String?
  heroImage       String?
  deliveryEnabled Boolean  @default(true)
  pickupEnabled   Boolean  @default(true)
  minimumOrder    Int      @default(0)
  deliveryFee     Int      @default(49)
  facebookUrl     String?
  instagramUrl    String?
  tiktokUrl       String?
  notificationEmail             String?
  emailSenderName               String?
  emailSenderAddress            String?
  customerEmailsEnabled         Boolean  @default(true)
  restaurantEmailsEnabled       Boolean  @default(true)
  notifyCustomerOrderConfirmation   Boolean @default(true)
  notifyCustomerPaymentConfirmation Boolean @default(true)
  notifyCustomerOrderReady          Boolean @default(true)
  notifyCustomerOrderDelivered      Boolean @default(true)
  notifyCustomerOrderCancelled      Boolean @default(true)
  notifyRestaurantNewOrder          Boolean @default(true)
  notifyRestaurantPaymentReceived   Boolean @default(true)
  notifyRestaurantOrderCancelled    Boolean @default(true)
  metaTitle                 String?
  metaDescription           String?
  ogImage                   String?
  keywords                  String?
  googleAnalyticsId         String?
  googleTagManagerId        String?
  googleAdsConversionId     String?
  metaPixelId               String?
  googleAnalyticsEnabled    Boolean  @default(false)
  googleTagManagerEnabled   Boolean  @default(false)
  googleAdsEnabled          Boolean  @default(false)
  metaPixelEnabled          Boolean  @default(false)
  stripeEnabled             Boolean  @default(false)
  stripeTestMode            Boolean  @default(true)
  stripePublishableKeyTest  String?
  stripeSecretKeyTest       String?
  stripeWebhookSecretTest   String?
  stripePublishableKeyLive  String?
  stripeSecretKeyLive       String?
  stripeWebhookSecretLive   String?
  rmsTerminalSettings       Json?
  rmsPrinterRegistry        Json?
  rmsEscposConfig           Json?
  rmsWindowsPrinterConfig   Json?
  updatedAt       DateTime @updatedAt
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model OpeningHours {
  id        String @id @default(cuid())
  tenantId  String
  dayOfWeek Int
  openTime  String
  closeTime String
  isClosed  Boolean @default(false)
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, dayOfWeek])
  @@index([tenantId])
}

model DeliveryZone {
  id           String @id @default(cuid())
  tenantId     String
  name         String
  postalCodes  String
  deliveryFee  Int    @default(49)
  minimumOrder Int    @default(0)
  tenant       Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model NotificationLog {
  id           String                     @id @default(cuid())
  orderId      String?
  type         NotificationType
  recipient    String
  subject      String
  status       NotificationDeliveryStatus @default(PENDING)
  errorMessage String?
  resendId     String?
  retryCount   Int                        @default(0)
  sentAt       DateTime?
  createdAt    DateTime                   @default(now())
  order        Order?                     @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([type])
  @@index([createdAt])
}

model Reservation {
  id         String            @id @default(cuid())
  tenantId   String
  userId     String?
  tableId    String?
  name       String
  phone      String
  email      String
  guestCount Int
  date       String
  time       String
  comment    String?
  status     ReservationStatus @default(NEW)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  table      RestaurantTable?  @relation(fields: [tableId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([tenantId])
  @@index([tableId])
  @@index([date])
  @@index([status])
  @@index([createdAt])
}

model RestaurantTable {
  id           String        @id @default(cuid())
  tenantId     String
  name         String
  capacity     Int
  mergeGroupId String?
  sortOrder    Int           @default(0)
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reservations Reservation[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([mergeGroupId])
}

model CustomerCrmProfile {
  id            String           @id @default(cuid())
  tenantId      String
  userId        String?          @unique
  email         String
  phone         String?
  name          String?
  address       String?
  vipLevel      CustomerVipLevel @default(REGULAR)
  tags          Json             @default("[]")
  loyaltyPoints Int              @default(0)
  vipOverride   Boolean          @default(false)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  adminNotes    CustomerAdminNote[]
  loyaltyEvents LoyaltyEvent[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([phone])
}

model CustomerAdminNote {
  id        String            @id @default(cuid())
  profileId String
  body      String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  profile   CustomerCrmProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model LoyaltyEvent {
  id          String            @id @default(cuid())
  profileId   String
  pointsDelta Int
  reason      String
  createdBy   String?
  createdAt   DateTime          @default(now())
  profile     CustomerCrmProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([createdAt])
}

model StaffNote {
  id        String   @id @default(cuid())
  userId    String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model StaffLoginEvent {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@index([createdAt])
}

model StaffAuditLog {
  id           String   @id @default(cuid())
  tenantId     String?
  actorUserId  String
  targetUserId String?
  category     String
  action       String
  details      String?
  createdAt    DateTime @default(now())
  actor        User     @relation("StaffAuditActor", fields: [actorUserId], references: [id], onDelete: Cascade)
  target       User?    @relation("StaffAuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([actorUserId])
  @@index([targetUserId])
  @@index([category])
  @@index([createdAt])
}

model PlatformInvoice {
  id               String                @id @default(cuid())
  tenantId         String
  invoiceNumber    String                @unique
  periodYear       Int
  periodMonth      Int
  invoiceDate      DateTime              @default(now())
  dueDate          DateTime?
  subscriptionFee  Int
  orderCount       Int
  orderFeePerOrder Int
  orderFeeTotal    Int
  vatRate          Int                   @default(0)
  vatAmount        Int                   @default(0)
  totalAmount      Int
  status           PlatformInvoiceStatus @default(DRAFT)
  sentAt           DateTime?
  paidAt           DateTime?
  emailSentTo      String?
  resendId         String?
  pdfData          String?               @db.Text
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  tenant           Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, periodYear, periodMonth])
  @@index([tenantId])
  @@index([status])
  @@index([periodYear, periodMonth])
}
