{
  "installCommand": "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 npm install --legacy-peer-deps",
  "buildCommand": "npm run build",
  "crons": [
    {
      "path": "/api/platform/billing/cron/monthly",
      "schedule": "0 6 1 * *"
    },
    {
      "path": "/api/platform/billing/cron/overdue",
      "schedule": "0 7 * * *"
    }
  ]
}
